{
  "expo": {
    "name": "EDM Service",
    "slug": "edm-field",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "mz.co.edm.field",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "mz.co.edm.field",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "EDM Service uses the camera to take photos of the work you have done.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F39B3A"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "EDM Service shares your location with your team and the office while you are on duty, so the nearest person gets urgent jobs. It stops when you go off duty.",
          "locationWhenInUsePermission": "EDM Service shares your location with your team and the office while you are on duty.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true,
          "locationAlwaysPermission": "EDM Service shares your location with your team and the office while you are on duty, so the nearest person gets urgent jobs. It stops when you go off duty.",
          "motionUsagePermission": false
        }
      ],
      "expo-font"
    ],
    "scheme": "edm",
    "extra": {
      "eas": {
        "projectId": "a6e50b33-1869-4977-a636-b7f68fb6ffd1"
      }
    },
    "owner": "huutu7165"
  }
}
