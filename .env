# Shared defaults for development. Put your own LAN address in .env.local (not committed), which overrides this file.
EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
EXPO_PUBLIC_KEYCLOAK_URL=http://192.168.1.20:58080
EXPO_PUBLIC_KEYCLOAK_REALM=edm
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=edm-mobile
# Push notifications: the project id from https://expo.dev (eas init). Without it the app works, and staff
# get job alerts by SMS instead. Push needs a development or store build; it does not work in Expo Go on Android.
EXPO_PUBLIC_EAS_PROJECT_ID=
